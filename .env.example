# Variáveis usadas no ambiente local e pelos manifests do Airflow.
# O banco de dados do desafio deve ser banvic_database.
# No Kind local, o Makefile detecta automaticamente o gateway da rede Docker.
# Para outro ambiente, defina POSTGRES_HOST com um endereço TCP alcançável.
POSTGRES_DB=banvic_database
AIRFLOW_DB=airflow
POSTGRES_USER=banvic
POSTGRES_PASSWORD=change_me
TARGET_POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Segredos usados pelo Airflow. Gere valores exclusivos para cada ambiente.
AIRFLOW_FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW_JWT_SECRET=change_this_jwt_secret
AIRFLOW_API_SECRET_KEY=change_this_api_secret
